@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->

<section class="hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <div class="hero-tag">
            <span></span>
            INDUSTRIAL & PLUMBING SOLUTIONS
        </div>

        <h1>
            Flowing Solutions.
            <br />
            <strong>Built to Last.</strong>
        </h1>

        <p>
            Reliable valves, pipes, hoses, pumps, tanks and
            plumbing solutions for industrial and commercial
            applications.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                Explore Products
                <span>→</span>
            </a>

            <a href="#solutions"
               class="btn btn-outline">
                Our Solutions
            </a>

        </div>

    </div>


    <!-- Hero information bar -->

    <div class="hero-bottom">

        <div>
            <strong>Quality</strong>
            <span>Products</span>
        </div>

        <div>
            <strong>Reliable</strong>
            <span>Solutions</span>
        </div>

        <div>
            <strong>Professional</strong>
            <span>Service</span>
        </div>

    </div>

</section>


<!-- =========================
     INTRODUCTION
========================= -->

<section class="intro-section">

    <div class="section-container">

        <div class="intro-text">

            <span class="section-label">
                PK VALVES cc
            </span>

            <h2>
                The right solution
                <span>for every flow.</span>
            </h2>

        </div>


        <div class="intro-description">

            <p>
                PK Valves cc provides dependable flow control,
                plumbing and industrial solutions designed
                around quality, performance and reliability.
            </p>

            <a href="#about" class="text-link">
                Learn more about us →
            </a>

        </div>

    </div>

</section>


<!-- =========================
     SOLUTIONS
========================= -->

<section class="solutions-section"
         id="solutions">

    <div class="section-container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    OUR SOLUTIONS
                </span>

                <h2>
                    Everything you need.
                </h2>

            </div>

            <p>
                Explore our range of products and solutions
                designed for industrial, commercial and
                plumbing applications.
            </p>

        </div>


        <div class="solution-grid">


            <!-- VALVES -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/valve.jpeg"
                         alt="Industrial valves" />

                    <div class="card-number">
                        01
                    </div>

                </div>

                <div class="card-content">

                    <span>FLOW CONTROL</span>

                    <h3>
                        Valves
                    </h3>

                    <p>
                        Reliable flow control solutions
                        for a wide range of industrial
                        applications.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>


            <!-- PIPES -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/pipes.jpeg"
                         alt="Industrial pipes" />

                    <div class="card-number">
                        02
                    </div>

                </div>

                <div class="card-content">

                    <span>FLOW SYSTEMS</span>

                    <h3>
                        Pipes
                    </h3>

                    <p>
                        Durable piping solutions built
                        for demanding environments.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>


            <!-- HOSES -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/hardware and tools.jpg"
                         alt="Industrial hardware and tools" />

                    <div class="card-number">
                        03
                    </div>

                </div>

                <div class="card-content">

                    <span>FLEXIBLE SOLUTIONS</span>

                    <h3>
                        Hardware And Tools
                    </h3>

                    <p>
                        A Variaty of Tools and Hardware
                        suited for any situation.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>


            <!-- PUMPS -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/pumps.jpeg"
                         alt="Industrial pumps" />

                    <div class="card-number">
                        04
                    </div>

                </div>

                <div class="card-content">

                    <span>WATER & FLOW</span>

                    <h3>
                        Pumps
                    </h3>

                    <p>
                        Efficient pumping solutions
                        designed for reliable performance.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>


            <!-- TANKS -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/tanks.jpeg"
                         alt="Industrial tanks" />

                    <div class="card-number">
                        05
                    </div>

                </div>

                <div class="card-content">

                    <span>STORAGE SOLUTIONS</span>

                    <h3>
                        Tanks
                    </h3>

                    <p>
                        Practical storage solutions for
                        commercial and industrial use.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>


            <!-- PLUMBING -->

            <div class="solution-card">

                <div class="card-image">

                    <img src="~/images/plumbing.jpeg"
                         alt="Plumbing solutions" />

                    <div class="card-number">
                        06
                    </div>

                </div>

                <div class="card-content">

                    <span>PLUMBING</span>

                    <h3>
                        Plumbing
                    </h3>

                    <p>
                        Dependable plumbing products for
                        a variety of applications.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index">
                        View Products →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     LARGE PROMOTIONAL BANNER
========================= -->

<section class="promo-banner">

    <div class="promo-image"></div>

    <div class="promo-content">

        <span class="section-label">
            PROFESSIONAL SOLUTIONS
        </span>

        <h2>
            Built for the demands
            <br />
            of <span>industry.</span>
        </h2>

        <p>
            From flow control to plumbing infrastructure,
            PK Valves cc delivers solutions you can depend on.
        </p>

        <a asp-controller="Contact"
           asp-action="Index"
           class="btn btn-primary">

            Speak to Our Team
            <span>→</span>

        </a>

    </div>

</section>


<!-- =========================
     PRODUCT CATALOGUE
========================= -->

<section class="products-section">

    <div class="section-container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    PRODUCT RANGE
                </span>

                <h2>
                    Our products.
                </h2>

            </div>

            <p>
                Our complete product catalogue will
                be available here soon.
            </p>

        </div>


        <div class="product-placeholder">

            <div class="placeholder-icon">
                +
            </div>

            <h3>
                Product catalogue coming soon
            </h3>

            <p>
                We are currently preparing our complete
                range of valves, pipes, hoses, pumps,
                tanks and plumbing products.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="text-link">

                View Product Catalogue →

            </a>

        </div>

    </div>

</section>


