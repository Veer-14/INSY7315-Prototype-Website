<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - PK Valves
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

</head>

<body>

    <header class="navbar">

        <div class="nav-container">

            <a class="logo"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/pk-logo.png"
                     alt="PK Valves"
                     class="pk-logo" />

            </a>


            <nav class="nav-links">

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Products"
                   asp-action="Index">
                    Products
                </a>

                <a href="/Home/Index#solutions">
                    Solutions
                </a>

                <a href="/Home/Index#about">
                    About
                </a>

                <a asp-controller="Contact"
                   asp-action="Index">
                    Contact
                </a>

                <a asp-controller="Wishlist"
                   asp-action="Index"
                   class="wishlist-nav">
                    Wishlist
                </a>

            </nav>


            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="user-account-wrapper">

                    <button type="button"
                            class="user-account-button"
                            id="userAccountButton">

                        <div class="user-account-info">

                            <span class="user-account-name">
                                @User.Identity.Name
                            </span>

                            <span class="user-account-status">
                                Logged in
                            </span>

                        </div>

                        <span class="user-account-arrow">
                            ▾
                        </span>

                    </button>


                    <div class="user-account-dropdown"
                         id="userAccountDropdown">

                        <div class="dropdown-user-info">

                            <strong>
                                @User.Identity.Name
                            </strong>

                            <span>
                                @User.FindFirst(
                                System.Security.Claims.ClaimTypes.Email
                                                        )?.Value
                        </span>

                        </div>


                        <div class="dropdown-divider"></div>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="logout-button">
                                Log out
                            </button>

                        </form>

                    </div>

                </div>
                        }
            else
            {
                <div class="nav-auth-buttons">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="nav-login">
                        Login
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="nav-register">
                        Register
                    </a>

                </div>
            }


            <button class="menu-toggle"
                    id="menuToggle">

                <span></span>
                <span></span>
                <span></span>

            </button>

        </div>

    </header>


    <main>

        @RenderBody()

    </main>


    <footer>

        <div class="footer-container">

            <div class="footer-brand">

                <a class="logo footer-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/pk-logo.png"
                         alt="PK Valves"
                         class="pk-logo footer-logo-image" />

                </a>

                <p>
                    Industrial and plumbing solutions
                    you can depend on.
                </p>

            </div>


            <div class="footer-column">

                <h4>Navigation</h4>

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Products"
                   asp-action="Index">
                    Products
                </a>

                <a href="/Home/Index#about">
                    About
                </a>

                <a asp-controller="Contact"
                   asp-action="Index">
                    Contact
                </a>

            </div>


            <div class="footer-column">

                <h4>Solutions</h4>

                <a href="/Home/Index#solutions">
                    Valves
                </a>

                <a href="/Home/Index#solutions">
                    Pipes
                </a>

                <a href="/Home/Index#solutions">
                    Hoses
                </a>

                <a href="/Home/Index#solutions">
                    Pumps
                </a>

            </div>


            <div class="footer-column">

                <h4>Contact</h4>

                <span>
                    South Africa
                </span>

                <a href="mailto:info@pkvalves.co.za">
                    info@pkvalves.co.za
                </a>

                <a href="tel:+27000000000">
                    +27 00 000 0000
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            <p>
                © 2026 PK Valves cc.
                All rights reserved.
            </p>

            <p>
                Industrial & Plumbing Solutions
            </p>

        </div>

    </footer>


    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const button =
                document.getElementById("userAccountButton");

            const dropdown =
                document.getElementById("userAccountDropdown");

            if (!button || !dropdown) {
                return;
            }

            button.addEventListener("click", function (event) {

                event.stopPropagation();

                dropdown.classList.toggle("show");

            });


            document.addEventListener("click", function () {

                dropdown.classList.remove("show");

            });


            dropdown.addEventListener("click", function (event) {

                event.stopPropagation();

            });

        });

    </script>

</body>

</html>